<Window x:Class="Recappi.Desktop.CloudSearchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Recappi.Desktop"
 Title="搜索已缓存录音" Width="720" Height="620" MinWidth="500" MinHeight="420" WindowStartupLocation="CenterOwner" Style="{StaticResource ModernWindow}">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="搜索录音内容" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16"/>
   <TextBlock Text="搜索此账号在本机已缓存的标题、摘要和逐字稿。未打开过的录音可能尚未缓存。" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <TextBox x:Name="Query" AutomationProperties.Name="搜索录音内容" Margin="0,0,0,8"/>
   <TextBlock Text="说话人原始标签（可选）"/><TextBox x:Name="Speaker" AutomationProperties.Name="搜索说话人" Margin="0,4,0,8"/>
   <Button local:ButtonIcon.Geometry="{StaticResource Icon.Search}" Content="搜索" Click="Search" HorizontalAlignment="Left" IsDefault="True" Style="{StaticResource AccentButton}"/>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,10" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <Button local:ButtonIcon.Geometry="{StaticResource Icon.External}" DockPanel.Dock="Bottom" Content="打开选中结果" Click="OpenSelected" HorizontalAlignment="Right" Margin="0,10,0,0"/>
  <ListBox x:Name="Results" MouseDoubleClick="OpenResult" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListItem}"/></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Recording.Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Source}" Opacity="0.65"/><TextBlock Text="{Binding Snippet}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </DockPanel>
</Window>
