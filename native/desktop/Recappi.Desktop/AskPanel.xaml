<UserControl x:Class="Recappi.Desktop.AskPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite"/>
   <ComboBox x:Name="Suggestions" SelectionChanged="ChooseSuggestion" AutomationProperties.Name="推荐问题"/>
   <TextBox x:Name="Question" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,8" AutomationProperties.Name="问题"/>
   <WrapPanel><CheckBox x:Name="WebSearch" Content="搜索网页" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="SendButton" Content="发送 / 重试" Click="Send" IsEnabled="False"/><Button x:Name="CancelButton" Content="停止" Click="Cancel" IsEnabled="False"/><Button x:Name="HistoryButton" Content="刷新历史" Click="RefreshHistory" IsEnabled="False"/></WrapPanel>
  </StackPanel>
  <ListBox x:Name="Citations" DockPanel.Dock="Bottom" MaxHeight="110" DisplayMemberPath="Display" SelectionChanged="SelectCitation" AutomationProperties.Name="回答引用"/>
  <TextBox x:Name="Conversation" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" AutomationProperties.Name="问答记录"/>
 </DockPanel>
</UserControl>
