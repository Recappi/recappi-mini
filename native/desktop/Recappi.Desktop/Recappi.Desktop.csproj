<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Recappi Mini</AssemblyName>
    <Version>0.1.0-preview.1</Version>
    <RootNamespace>Recappi.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Recappi.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Recappi.Core/Recappi.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/*.ico" /><Resource Include="Assets/*.png" /></ItemGroup>
</Project>
