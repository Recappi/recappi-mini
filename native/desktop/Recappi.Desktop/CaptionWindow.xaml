<Window x:Class="Recappi.Desktop.CaptionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Recappi Mini · 实时字幕" Width="650" Height="420" MinWidth="360" MinHeight="240" Topmost="True" ShowActivated="False" Style="{StaticResource ModernWindow}">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource AccentButton}"/><Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}"/>
  <Style x:Key="CaptionText" TargetType="TextBox">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="FontSize" Value="20"/><Setter Property="TextBlock.LineHeight" Value="28"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="ClipToBounds" Value="True"/>
   <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
 </Window.Resources>
 <DockPanel x:Name="CaptionLayout" Margin="20" SizeChanged="CaptionChromeChanged">
  <WrapPanel x:Name="CaptionOptions" DockPanel.Dock="Top" Margin="0,0,0,10" SizeChanged="CaptionChromeChanged"><CheckBox x:Name="SourceVisible" Content="原文" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged" Margin="0,0,15,0"/><CheckBox x:Name="TranslationVisible" Content="译文" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged" Margin="0,0,15,0"/><CheckBox x:Name="Compact" Content="紧凑模式" Checked="OptionsChanged" Unchecked="OptionsChanged"/></WrapPanel>
  <StackPanel x:Name="StatusPanel" DockPanel.Dock="Bottom" Margin="0,10,0,0" SizeChanged="CaptionChromeChanged"><TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="ArchiveStatus" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/><Button x:Name="RetryButton" Content="重新连接字幕" Click="RetryCaptions" Visibility="Collapsed" Margin="0,6,0,0"/></StackPanel>
  <Grid x:Name="Panes">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SourceColumn" Width="57*"/><ColumnDefinition x:Name="TranslationColumn" Width="43*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition x:Name="SourceRow" Height="*"/><RowDefinition x:Name="TranslationRow" Height="0"/></Grid.RowDefinitions>
   <Border x:Name="SourcePane" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12" Margin="0,0,6,0">
    <DockPanel><TextBlock x:Name="SourceHeading" DockPanel.Dock="Top" Text="原文" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBox x:Name="SourceTranscript" Style="{StaticResource CaptionText}" AutomationProperties.Name="实时字幕原文"/>
    </DockPanel>
   </Border>
   <Border x:Name="TranslationPane" Grid.Column="1" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12" Margin="6,0,0,0">
    <DockPanel><TextBlock x:Name="TranslationHeading" DockPanel.Dock="Top" Text="译文" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBox x:Name="TranslationTranscript" Style="{StaticResource CaptionText}" AutomationProperties.Name="实时字幕译文"/>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</Window>
