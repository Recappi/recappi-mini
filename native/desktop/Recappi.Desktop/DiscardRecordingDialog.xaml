<Window x:Class="Recappi.Desktop.DiscardRecordingDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Recappi.Desktop"
 Title="丢弃录音" Width="420" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource ModernWindow}">
 <StackPanel Margin="16">
  <TextBlock Text="丢弃当前录音？" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBlock Text="这条录音的本地音频和实时字幕将被删除。其他录音不会受到影响。" TextWrapping="Wrap" Margin="0,0,0,20"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="KeepButton" Content="保留录音" IsCancel="True" IsDefault="True" local:ButtonIcon.Geometry="{StaticResource Icon.Close}"/>
   <Button x:Name="DiscardButton" Content="丢弃录音" Click="Discard" local:ButtonIcon.Geometry="{StaticResource Icon.Trash}"/>
  </StackPanel>
 </StackPanel>
</Window>
