<Window x:Class="Recappi.Desktop.AccountWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Recappi.Desktop"
 Title="Recappi Mini · 账号" Width="480" MaxHeight="800" SizeToContent="Height" ResizeMode="CanMinimize" Style="{StaticResource ModernWindow}">
 <Window.Resources><Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/></Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
  <TextBlock Text="Recappi 账号" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock x:Name="Identity" Margin="0,16,0,4" TextWrapping="Wrap"/>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"/>
  <Border x:Name="PromptPanel" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
   <StackPanel><TextBlock Text="在浏览器中确认登录，输入以下代码：" TextWrapping="Wrap"/><TextBlock x:Name="Code" FontSize="28" FontWeight="SemiBold" Margin="0,10" TextAlignment="Center"/><Button local:ButtonIcon.Geometry="{StaticResource Icon.External}" Content="打开登录页面" Click="OpenVerification" AutomationProperties.AutomationId="account.open-verification"/></StackPanel>
  </Border>
  <WrapPanel><Button local:ButtonIcon.Geometry="{StaticResource Icon.Account}" x:Name="SignInButton" Content="登录 / 重新连接" Click="SignIn" AutomationProperties.AutomationId="account.sign-in" Style="{StaticResource AccentButton}"/><Button local:ButtonIcon.Geometry="{StaticResource Icon.Refresh}" x:Name="RefreshButton" Content="检查连接" Click="Refresh"/><Button local:ButtonIcon.Geometry="{StaticResource Icon.Close}" x:Name="CancelButton" Content="取消" Click="Cancel"/></WrapPanel>
  <Button local:ButtonIcon.Geometry="{StaticResource Icon.Exit}" x:Name="SignOutButton" Content="退出账号" Click="SignOut" HorizontalAlignment="Left" Margin="0,14,0,0" AutomationProperties.AutomationId="account.sign-out"/>
  <ContentControl x:Name="BillingContent"/>
  <TextBlock Text="未登录时仍可在本机录音。登录后可以上传、转写和整理会议内容。" TextWrapping="Wrap" Margin="0,20,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
