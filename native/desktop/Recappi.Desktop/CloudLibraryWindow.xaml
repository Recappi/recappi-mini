<Window x:Class="Recappi.Desktop.CloudLibraryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Recappi.Desktop"
 Title="Recappi Mini · 录音库" Width="1120" Height="760" MinWidth="800" MinHeight="540" FontFamily="Segoe UI Variable, Microsoft YaHei UI" FontSize="14" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
  <Style TargetType="TextBox" BasedOn="{StaticResource ModernInput}"/>
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListItem}"/>
  <GroupStyle x:Key="DateGroups"><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" Opacity="0.65" FontWeight="SemiBold" Margin="10,12,0,6"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle>
 </Window.Resources>
 <DockPanel Margin="16,12">
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Image DockPanel.Dock="Left" Width="36" Height="36" Source="/Recappi Mini;component/Assets/Recappi.png" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0"/><StackPanel><TextBlock Text="Recappi Mini" FontSize="12" Opacity="0.65"/><TextBlock Text="录音库" FontSize="22" FontWeight="SemiBold"/></StackPanel></DockPanel>
  <Border x:Name="CurrentMeeting" DockPanel.Dock="Top" Visibility="Collapsed" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Padding="10" Margin="0,0,0,10">
   <DockPanel><Button local:ButtonIcon.Geometry="{StaticResource Icon.Record}" x:Name="CurrentMeetingButton" DockPanel.Dock="Right" Content="返回录音控制" Click="OpenCurrentMeeting" AutomationProperties.AutomationId="library.current-meeting"/><TextBlock x:Name="CurrentMeetingLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
  </Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="搜索录音" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>
    <TextBox x:Name="LibraryQuery" Height="32" Padding="8,0" VerticalContentAlignment="Center" TextChanged="LibraryQueryChanged" AutomationProperties.Name="搜索本机录音和云端缓存" ToolTip="本机录音标题，以及此账号已缓存的标题、摘要和逐字稿"/>
    <TextBlock x:Name="LibrarySearchStatus" TextWrapping="Wrap" Margin="0,4" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <WrapPanel><Button local:ButtonIcon.Geometry="{StaticResource Icon.Import}" x:Name="ImportLocalButton" Content="导入音频" Click="ImportLocal" Visibility="Collapsed" Style="{StaticResource AccentButton}"/><Button local:ButtonIcon.Geometry="{StaticResource Icon.Close}" x:Name="CancelLocalImportButton" Content="取消导入" Click="CancelLocalImport" Visibility="Collapsed"/><Button local:ButtonIcon.Geometry="{StaticResource Icon.Refresh}" x:Name="RefreshButton" Content="刷新" Click="RefreshClick" Style="{StaticResource QuietButton}"/></WrapPanel>
    <TextBlock x:Name="ImportLocalStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6" AutomationProperties.LiveSetting="Polite"/>
    <Button local:ButtonIcon.Geometry="{StaticResource Icon.Search}" Content="按说话人搜索" Click="SearchCache" HorizontalAlignment="Left" Style="{StaticResource QuietButton}"/>
   </StackPanel>
   <StackPanel Grid.Row="2" Margin="0,12,0,0">
    <Button local:ButtonIcon.Geometry="{StaticResource Icon.Plus}" x:Name="MoreButton" Content="加载更多" Click="MoreClick" IsEnabled="False" HorizontalAlignment="Left"/>
    <Button local:ButtonIcon.Geometry="{StaticResource Icon.Account}" x:Name="AccountButton" Click="OpenAccount" HorizontalContentAlignment="Stretch" Margin="0" Padding="10,8" AutomationProperties.Name="管理账号"><StackPanel><TextBlock x:Name="AccountIdentity" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AccountConnection" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></Button>
   </StackPanel>
   <ListBox Grid.Row="1" x:Name="LibrarySearchResults" Visibility="Collapsed" SelectionChanged="SelectLibrarySearchResult" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="library.search-results"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Source}" FontSize="12" Opacity="0.65" Margin="0,5"/><TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" MaxHeight="64"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Grid Grid.Row="1" x:Name="LibraryLists">
    <ListBox x:Name="Recordings" SelectionChanged="SelectRecording" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True" AutomationProperties.AutomationId="library.recordings" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.GroupStyle><StaticResource ResourceKey="DateGroups"/></ListBox.GroupStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Location}" FontSize="12" Opacity="0.65" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
   </Grid>
   <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}" Padding="14">
   <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Height="{Binding ActualHeight, ElementName=DetailScroll}">
    <Grid.Style><Style TargetType="Grid"><Setter Property="MinHeight" Value="560"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=DetailTabs}" Value="2"><Setter Property="MinHeight" Value="640"/></DataTrigger><DataTrigger Binding="{Binding IsExpanded, ElementName=AudioSection}" Value="True"><Setter Property="MinHeight" Value="760"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <DockPanel>
   <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding Visibility, ElementName=CloudDetail}">
    <Button local:ButtonIcon.Geometry="{StaticResource Icon.External}" x:Name="BrowserButton" Content="浏览器打开" Click="OpenBrowser" IsEnabled="False"/>
    <Button local:ButtonIcon.Geometry="{StaticResource Icon.Import}" x:Name="ExportButton" Content="导出文字" Click="ExportText" IsEnabled="False"/>
    <Button local:ButtonIcon.Geometry="{StaticResource Icon.Trash}" x:Name="DeleteButton" Content="删除云端录音" Click="DeleteRecording" IsEnabled="False"/>
   </WrapPanel>
   <WrapPanel DockPanel.Dock="Top" x:Name="CopyActions" Visibility="Collapsed" Margin="0,0,0,8"><Button local:ButtonIcon.Geometry="{StaticResource Icon.Folder}" x:Name="LocalCopyButton" Content="本机音频" Click="OpenLocalCopy"/><Button local:ButtonIcon.Geometry="{StaticResource Icon.Cloud}" x:Name="CloudCopyButton" Content="云端内容" Click="OpenCloudCopy"/></WrapPanel>
   <Grid>
   <ContentControl x:Name="LocalDetail" Visibility="Collapsed"/>
   <DockPanel x:Name="CloudDetail">
    <Expander x:Name="AudioSection" DockPanel.Dock="Bottom" Header="音频播放与下载" Margin="0,8,0,0"><StackPanel><TextBlock x:Name="PlaybackLabel" TextWrapping="Wrap"/><WrapPanel><Button local:ButtonIcon.Geometry="{StaticResource Icon.Play}" x:Name="LoadAudioButton" Content="加载所选录音音频" Click="LoadAudio" IsEnabled="False"/><Button local:ButtonIcon.Geometry="{StaticResource Icon.Import}" x:Name="SaveAudioButton" Content="保存音频副本" Click="SaveAudio" IsEnabled="False"/></WrapPanel><local:AudioPlayer x:Name="Player"/></StackPanel></Expander>
    <TextBlock x:Name="Heading" DockPanel.Dock="Top" Text="选择一条云端录音" FontSize="21" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,12"/>
    <TabControl x:Name="DetailTabs">
     <TabItem Header="转写"><local:TranscriptPanel x:Name="Transcript"/></TabItem>
     <TabItem Header="摘要"><TextBox x:Name="Summary" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="8"/></TabItem>
     <TabItem Header="问答"><local:AskPanel x:Name="Ask"/></TabItem>
     <TabItem Header="处理与版本"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:ReviewPanel x:Name="Review" Margin="0,12,0,0"/></ScrollViewer></TabItem>
    </TabControl>
   </DockPanel>
   </Grid>
   </DockPanel>
   </Grid>
   </ScrollViewer>
   </Border>
  </Grid>
 </DockPanel>
</Window>
