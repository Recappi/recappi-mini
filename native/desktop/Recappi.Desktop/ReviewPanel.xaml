<UserControl x:Class="Recappi.Desktop.ReviewPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Recappi.Desktop">
 <StackPanel Margin="0,0,0,12">
  <DockPanel><Button local:ButtonIcon.Geometry="{StaticResource Icon.Captions}" x:Name="LatestButton" Content="当前版本" Click="Latest" DockPanel.Dock="Left"/><Button local:ButtonIcon.Geometry="{StaticResource Icon.Refresh}" x:Name="RefreshButton" Content="刷新任务" Click="Refresh" DockPanel.Dock="Right"/><ComboBox x:Name="Jobs" DisplayMemberPath="Display" SelectionChanged="SelectVersion" AutomationProperties.Name="转写历史版本"/></DockPanel>
  <WrapPanel Margin="0,8"><Button local:ButtonIcon.Geometry="{StaticResource Icon.Refresh}" x:Name="TranscribeButton" Content="重新转写" Click="Transcribe" IsEnabled="False"/><Button local:ButtonIcon.Geometry="{StaticResource Icon.Refresh}" x:Name="SummaryButton" Content="重新生成摘要" Click="Summarize" IsEnabled="False"/><Button local:ButtonIcon.Geometry="{StaticResource Icon.Refresh}" x:Name="RetryButton" Content="重试失败分块" Click="RetryChunks" IsEnabled="False"/></WrapPanel>
  <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
</UserControl>
