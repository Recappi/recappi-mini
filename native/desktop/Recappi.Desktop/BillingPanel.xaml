<UserControl x:Class="Recappi.Desktop.BillingPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Recappi.Desktop">
 <UserControl.Resources><Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource StrokeBrush}"/><Setter Property="BorderThickness" Value="0"/></Style></UserControl.Resources>
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,16,0,0">
  <StackPanel>
   <TextBlock Text="套餐与用量" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel x:Name="Usage" Visibility="Collapsed">
    <TextBlock x:Name="Tier" FontWeight="SemiBold" Margin="0,12,0,8"/>
    <TextBlock x:Name="Storage" TextWrapping="Wrap"/><ProgressBar x:Name="StorageProgress" Height="5" Maximum="100" Margin="0,5,0,12" AutomationProperties.Name="云端存储用量"/>
    <TextBlock x:Name="Minutes" TextWrapping="Wrap"/><ProgressBar x:Name="MinutesProgress" Height="5" Maximum="100" Margin="0,5,0,12" AutomationProperties.Name="转写分钟用量"/>
    <TextBlock x:Name="Period" TextWrapping="Wrap"/>
   </StackPanel>
   <WrapPanel Margin="0,12,0,0"><Button local:ButtonIcon.Geometry="{StaticResource Icon.Refresh}" x:Name="RefreshButton" Content="刷新用量" Click="Refresh" AutomationProperties.AutomationId="billing.refresh"/><Button local:ButtonIcon.Geometry="{StaticResource Icon.External}" x:Name="ManageButton" Content="管理订阅…" Click="Manage" Margin="8,0,0,0" AutomationProperties.AutomationId="billing.manage"/></WrapPanel>
  </StackPanel>
 </Border>
</UserControl>
