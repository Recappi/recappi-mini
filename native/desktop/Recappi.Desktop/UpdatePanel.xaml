<UserControl x:Class="Recappi.Desktop.UpdatePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="0,12,0,0">
  <TextBlock Text="更新" FontSize="18"/>
  <TextBlock x:Name="UpdateDescription" Text="从 Recappi 官方 GitHub 发布页检查适合本机的 Windows 版本。" TextWrapping="Wrap" Margin="0,6,0,6"/>
  <WrapPanel>
   <Button x:Name="CheckButton" Content="检查更新" Click="Check"/>
   <Button x:Name="DownloadButton" Content="下载更新包" Click="Download" IsEnabled="False"/>
   <Button x:Name="CancelButton" Content="取消" Click="Cancel" Visibility="Collapsed"/>
   <Button x:Name="ReleaseButton" Content="查看官方发布页" Click="OpenRelease"/>
   <Button x:Name="StoreButton" Content="打开 Microsoft Store 更新" Click="OpenStore" Visibility="Collapsed"/>
  </WrapPanel>
  <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="1" Height="5" Margin="0,8,0,0" Visibility="Collapsed"/>
  <TextBlock x:Name="UpdateStatus" Text="仅在点击检查时联网。当前为便携版，下载后需要手动解压更新。" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  <Button x:Name="OpenPackageButton" Content="打开下载目录" Click="OpenPackage" HorizontalAlignment="Left" Visibility="Collapsed"/>
 </StackPanel>
</UserControl>
